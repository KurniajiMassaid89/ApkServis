<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Servis Motor"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Rawat motormu, pantau setiap kilometer"
        android:textColor="@color/text_blue_soft"
        android:textSize="13sp" />

    <!-- Hero Card Rekapan Per Bulan -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/hero_teal"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Baris Atas: Label Bulan & Tombol Ganti Bulan -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLabelBulan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Biaya Bulan Ini"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPilihBulan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/text_dark"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="📅 Ganti Bulan"
                        android:textColor="@color/accent_mint"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Nominal Total Biaya Bulanan -->
            <TextView
                android:id="@+id/tvTotalSemua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rp 0"
                android:textColor="@color/text_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Garis Pemisah Halus -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#330F172A" />

            <!-- Info Tanggal & Deskripsi Servis Terakhir -->
            <TextView
                android:id="@+id/tvInfoServisTerakhir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada servis tercatat di bulan ini"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Besar Full-Width agar Mudah Dilihat & Ditekan -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTambahKategori"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/accent_mint"
        android:text="+ Tambah Kategori Servis"
        android:textAllCaps="false"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp" />

    <TextView
        android:id="@+id/tvJumlahKategori"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Daftar Kategori (0 aktif)"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKategori"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>